PORT=5000
NODE_ENV=development
# Persistent MongoDB. Local dev works without it (ephemeral in-memory Mongo),
# but production MUST set this to a MongoDB Atlas connection string.
# DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
# Auth — generate a long random string for production:
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# First-boot demo account (created only when the database is empty):
DEMO_EMAIL=demo@flowboard.app
DEMO_PASSWORD=demo1234
